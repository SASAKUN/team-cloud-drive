<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title + ' — ' : '' %>Team Cloud Drive</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <nav class="navbar">
    <div class="container nav-container">
      <a href="/" class="nav-brand">Team Cloud Drive</a>
      <div class="nav-links">
        <% if (isAdmin) { %>
        <a href="/admin" class="nav-link">管理后台</a>
        <a href="/admin/logout" class="nav-link nav-logout">退出</a>
        <% } else { %>
        <a href="/admin/login" class="nav-link">管理登录</a>
        <% } %>
      </div>
    </div>
  </nav>

  <main class="container">
    <div class="login-page">
      <div class="login-card">
        <h1>管理登录</h1>
        <p class="login-subtitle">请输入管理员密码</p>

        <% if (error) { %>
        <div class="alert alert-error"><%= error %></div>
        <% } %>

        <form method="POST" action="/admin/login" class="login-form">
          <label for="password">密码</label>
          <input type="password" id="password" name="password" placeholder="输入管理密码" required autofocus>
          <button type="submit" class="btn btn-primary btn-full">登录</button>
        </form>

        <p class="login-hint">
          <a href="/">← 返回文件列表</a>
        </p>
      </div>
    </div>
  </main>

  <script src="/js/main.js"></script>
  <script src="/js/upload.js"></script>
</body>
</html>
