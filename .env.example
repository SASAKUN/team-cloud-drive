PORT=3000
ADMIN_PASSWORD=change-me
SESSION_SECRET=change-me-to-a-random-string
UPLOAD_DIR=./data/uploads
DATABASE_PATH=./data/database.sqlite
MAX_FILE_SIZE_MB=500
# BASE_URL is auto-detected from request headers — no need to set

# ===== Tencent Cloud COS (S3-compatible, permanent storage) =====
# Get these from Tencent Cloud Console → Access Keys → API Keys
# COS_SECRET_ID=your-secret-id
# COS_SECRET_KEY=your-secret-key
# Bucket name format: name-appid (e.g., team-cloud-drive-1234567890)
# COS_BUCKET=team-cloud-drive-1234567890
# COS_REGION=ap-guangzhou
# Regions: ap-guangzhou, ap-shanghai, ap-beijing, ap-nanjing, ap-chengdu, ap-chongqing, ap-hongkong, ap-singapore, etc.
