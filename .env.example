PORT=3000
ADMIN_PASSWORD=change-me
SESSION_SECRET=change-me-to-a-random-string
UPLOAD_DIR=./data/uploads
DATABASE_PATH=./data/database.sqlite
MAX_FILE_SIZE_MB=500
# BASE_URL is auto-detected from request headers — no need to set

# ===== Supabase Storage (Recommended) =====
# Files are stored permanently in Supabase Storage.
# Get these values from Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Bucket name (create this bucket in Supabase Dashboard → Storage)
SUPABASE_STORAGE_BUCKET=files

# ===== Cloudflare R2 (Legacy — TLS incompatible with Render) =====
# R2_ACCOUNT_ID=your-account-id
# R2_ACCESS_KEY_ID=your-access-key
# R2_SECRET_ACCESS_KEY=your-secret-key
# R2_BUCKET_NAME=your-bucket
# R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# R2_PUBLIC_URL=https://pub-xxxxxxxxxxxx.r2.dev
