PORT=3000
ADMIN_PASSWORD=change-me
SESSION_SECRET=change-me-to-a-random-string
UPLOAD_DIR=./data/uploads
DATABASE_PATH=./data/database.sqlite
MAX_FILE_SIZE_MB=500
# BASE_URL is auto-detected from request headers — no need to set

# ===== Cloudflare R2 (Object Storage) =====
# R2_ACCOUNT_ID=your-account-id
# R2_ACCESS_KEY_ID=your-access-key
# R2_SECRET_ACCESS_KEY=your-secret-key
# R2_BUCKET_NAME=your-bucket
# R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com

# R2 public domain for browser-accessible presigned download URLs.
# Get this from Cloudflare Dashboard → R2 → bucket → Settings → Public Access.
# Format: https://pub-<hash>.r2.dev
# Without this, presigned URLs use the S3 API endpoint which browsers cannot connect to.
# R2_PUBLIC_URL=https://pub-xxxxxxxxxxxx.r2.dev
